# DEV: local developer laptop, usually SQLite and Vite.
# TEST: local virtual server or internal trial server.
# PROD: future production deployment. Use strong secrets and MySQL.
APP_ENV=DEV

# SQLite development:
DATABASE_URL=sqlite:///./dorm_commute.db

# MySQL internal trial / future production:
# DATABASE_URL=mysql+pymysql://dorm_user:password@localhost:3306/dorm_management

SECRET_KEY=change-this-secret-for-real-use
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
